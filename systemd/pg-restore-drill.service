[Unit]
Description=Restore drill: restore latest dump into a throwaway database and verify
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/opt/pg-backup-recovery-lab/scripts/restore_drill.sh
# A backup should never fight the database for CPU and disk
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
