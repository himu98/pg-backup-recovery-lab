# Copy to /etc/pg-backup/backup.env and adjust.
#   sudo mkdir -p /etc/pg-backup && sudo cp config/backup.env.example /etc/pg-backup/backup.env

BACKUP_ROOT=/var/backups/postgres
WAL_ARCHIVE=/var/lib/pgsql/wal_archive

# Space-separated list of databases for pg_dump
DATABASES="shopdb"

LOGICAL_RETENTION_DAYS=7
BASE_BACKUPS_TO_KEEP=2

# check_backup_freshness.sh fails if the newest dump is older than this
MAX_BACKUP_AGE_HOURS=26

# Leave empty for now. In the observability project this becomes node_exporter's textfile directory.
METRICS_DIR=
